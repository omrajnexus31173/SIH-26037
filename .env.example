# Copy to .env. setup_windows.bat does this automatically.
# HTTP mode works for localhost. For phone camera access over a LAN IP, set
# SIH_USE_HTTPS=1 and trust certs/sih-26037.crt on the phone.
SIH_HOST=0.0.0.0
SIH_BACKEND_PORT=8000
SIH_FRONTEND_PORT=5173
SIH_USE_HTTPS=0
SIH_PUBLIC_PAIR_BASE_URL=

# CPU-friendly inference defaults. Raise AI_FPS only if measured CPU allows it.
SIH_AI_FPS=6
SIH_CAMERA_FPS=20
SIH_SIM_FPS=20
SIH_BROADCAST_FPS=8

# Models and optional acceleration
SIH_DETECTOR=opencv_onnx
SIH_YOLO_MODEL=yolov8n.onnx
SIH_SEG_MODEL=twinlitenet_da.onnx
SIH_CONF=0.35
SIH_IOU=0.45
SIH_USE_CUDA=0

SIH_PAIRING_TTL=900
SIH_MAX_UPLOAD_MB=200
