# Backend example. Copy values into the backend host's environment variables.
# Do not put real secrets here: this project has no database or API-key secrets.

# Render/Railway/Fly/Heroku-style hosts usually inject PORT automatically.
# SIH_BACKEND_PORT overrides PORT when both are present.
SIH_HOST=0.0.0.0
SIH_BACKEND_PORT=8000
SIH_USE_HTTPS=0

# Optional public /pair base for QR candidates. Usually leave empty because the
# frontend sends its own Netlify origin to /api/pairing/session.
SIH_PUBLIC_PAIR_BASE_URL=

# CPU-friendly runtime defaults.
SIH_AI_FPS=8
SIH_CAMERA_FPS=20
SIH_SIM_FPS=20
SIH_BROADCAST_FPS=8
SIH_PAIRING_TTL=900
SIH_MAX_UPLOAD_MB=200

# Bundled model files and CPU detector.
SIH_DETECTOR=opencv_onnx
SIH_YOLO_MODEL=yolov8n.onnx
SIH_SEG_MODEL=twinlitenet_da.onnx
SIH_CONF=0.35
SIH_IOU=0.45
SIH_USE_CUDA=0
